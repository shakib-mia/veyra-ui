{
	"name": "veyra-ui",
	"version": "0.1.0",
	"description": "A reusable React UI component library",
	"type": "module",
	"main": "./dist/veyra-ui.cjs",
	"module": "./dist/veyra-ui.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/veyra-ui.js",
			"require": "./dist/veyra-ui.cjs"
		},
		"./styles.css": "./dist/veyra-ui.css"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "eslint .",
		"preview": "vite preview"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"lucide-react": "^1.30.0",
		"react-day-picker": "^10.0.1",
		"react-select": "^5.10.2",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.4",
		"eslint": "^10.8.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.3",
		"globals": "^17.7.0",
		"jsdom": "^29.1.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"typescript": "~6.0.2",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.2.0",
		"vite-plugin-dts": "^5.0.3",
		"vitest": "^4.1.10"
	}
}
