{
	"name": "veyra-ui",
	"version": "0.1.10",
	"description": "A reusable React UI component library for modern React applications.",
	"type": "module",
	"module": "./dist/veyra-ui.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/veyra-ui.js"
		},
		"./styles.css": "./dist/veyra-ui.css"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"sideEffects": [
		"*.css"
	],
	"scripts": {
		"dev": "vite",
		"build": "tsc -p tsconfig.build.json && vite build",
		"lint": "eslint .",
		"preview": "vite preview"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0",
		"react-select": "^5.10.0"
	},
	"dependencies": {
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"lucide-react": "^1.30.0",
		"react-day-picker": "^10.0.0",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^24.13.0",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.4",
		"eslint": "^10.8.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.3",
		"globals": "^17.7.0",
		"jsdom": "^29.1.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"typescript": "~6.0.2",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.2.0",
		"vite-plugin-dts": "^5.0.3",
		"vitest": "^4.1.10",
		"react-select": "^5.10.0"
	}
}
