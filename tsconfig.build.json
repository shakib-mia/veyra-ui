{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023", "DOM"],
		"module": "ESNext",
		"moduleResolution": "Bundler",

		"jsx": "react-jsx",

		"strict": true,
		"skipLibCheck": true,

		"declaration": true,
		"emitDeclarationOnly": true,

		"rootDir": "src",
		"outDir": "dist",

		"verbatimModuleSyntax": true,
		"isolatedModules": true,

		"noEmitOnError": true
	},

	"include": [
		"src/index.ts",
		"src/**/*.d.ts",
		"src/components/**/*.ts",
		"src/components/**/*.tsx",
		"src/lib/**/*.ts",
		"src/lib/**/*.tsx"
	],

	"exclude": ["src/main.tsx", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
